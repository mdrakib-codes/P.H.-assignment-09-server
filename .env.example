NODE_ENV=development
PORT=5000
# Exactly one allowed browser origin. Use CLIENT_ORIGINS for additional origins.
CLIENT_ORIGIN=http://localhost:3000
CLIENT_ORIGINS=
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.example.com/fixmate?retryWrites=true&w=majority
STRIPE_SECRET_KEY=sk_test_<replace_me>
STRIPE_WEBHOOK_SECRET=whsec_<replace_me>
# Server-side ImgBB key. Keep this out of client code and version control.
IMGBB_API_KEY=imgbb_REPLACE_ME

# Optional: comma-separated IP addresses used for Atlas SRV/TXT lookups.
# Example: MONGODB_DNS_SERVERS=8.8.8.8,8.8.4.4
# MONGODB_DNS_SERVERS=

# Optional reverse-proxy and rate-limit settings. Shown values are defaults.
# TRUST_PROXY=false
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=600
# HEALTH_RATE_LIMIT_MAX=120
# SERVICE_RATE_LIMIT_MAX=120
# WEBHOOK_RATE_LIMIT_MAX=1000
# RATE_LIMIT_MAX_ENTRIES=10000

# Production requires explicit CORS origins and Stripe credentials.
# Stripe values must be test-mode placeholders here; never commit real credentials.
